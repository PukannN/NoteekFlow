<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteekFlow.ViewModels"
             xmlns:loc="using:NoteekFlow.Resources"
             x:DataType="vm:ImageViewModel"
             x:Class="NoteekFlow.Views.ImageView">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackground}">
        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackground}"
                BorderBrush="{DynamicResource PanelBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,5">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource ErrorForeground}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button Content="−"
                        Command="{Binding ZoomOutCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.ZoomOut}" />
                <Button Content="{Binding ZoomLabel}"
                        Command="{Binding ResetZoomCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.ResetZoom}" />
                <Button Content="+"
                        Command="{Binding ZoomInCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.ZoomIn}" />
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Image Source="{Binding ImageSource}"
                   Width="{Binding ImageWidth}"
                   Height="{Binding ImageHeight}"
                   Stretch="Fill" />
        </ScrollViewer>
    </Grid>
</UserControl>
