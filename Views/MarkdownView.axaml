<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteekFlow.ViewModels"
             xmlns:loc="using:NoteekFlow.Resources"
             xmlns:controls="using:NoteekFlow.Controls"
             x:Class="NoteekFlow.Views.MarkdownView"
             x:DataType="vm:MarkdownViewModel">
    <Grid RowDefinitions="Auto,*" 
          Background="{DynamicResource AppBackground}">
        <Border Grid.Row="0" 
                     Background="{DynamicResource PanelBackground}" 
                     BorderBrush="{DynamicResource PanelBorder}" 
                     BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="16,7">
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="{DynamicResource ErrorForeground}" 
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="−"
                        Command="{Binding ZoomOutCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.ZoomOut}"
                        Classes="toolbar"
                        Margin="0,0,4,0" />
                <Button Grid.Column="2"
                        Content="{Binding ZoomLabel}"
                        Command="{Binding ResetZoomCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.ResetZoom}"
                        Classes="toolbar"
                        Margin="0,0,4,0" />
                <Button Grid.Column="3"
                        Content="+"
                        Command="{Binding ZoomInCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.ZoomIn}"
                        Classes="toolbar"
                        Margin="0,0,8,0" />
                <Button Grid.Column="4"
                        Content="{x:Static loc:Strings.Edit}"
                        Command="{Binding ShowEditCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.MarkdownEditTooltip}"
                        Classes="toolbar"
                        Margin="0,0,6,0" />
                <Button Grid.Column="5"
                        Content="{x:Static loc:Strings.Preview}"
                        Command="{Binding ShowPreviewCommand}"
                        ToolTip.Tip="{x:Static loc:Strings.MarkdownPreviewTooltip}"
                        Classes="toolbar" />
            </Grid>
        </Border>
        <TextBox Grid.Row="1"
                 Text="{Binding Content, Mode=TwoWay}"
                 IsVisible="{Binding IsEditing}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 Padding="48,34"
                 FontFamily="Consolas"
                 FontSize="{Binding EditorFontSize}"
                 Foreground="{DynamicResource TextPrimary}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <controls:MarkdownPreviewControl Grid.Row="1"
                                         Zoom="{Binding Zoom}"
                                         Markdown="{Binding Content}"
                                         IsVisible="{Binding IsPreview}" />
    </Grid>                              
</UserControl>
