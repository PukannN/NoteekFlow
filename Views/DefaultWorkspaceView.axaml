<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteekFlow.ViewModels"
             x:DataType="vm:DefaultWorkspaceViewModel"
             x:Class="NoteekFlow.Views.DefaultWorkspaceView">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <TextBlock Text="Select a file from the sidebar to start editing."
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16" />
    </ScrollViewer>
</UserControl>
