<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NoteekFlow.ViewModels"
             xmlns:loc="using:NoteekFlow.Resources"
             x:DataType="vm:DefaultWorkspaceViewModel"
             x:Class="NoteekFlow.Views.DefaultWorkspaceView">
             
    <Grid Background="{DynamicResource AppBackground}">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="{x:Static loc:Strings.WelcomeTitle}"
                        Foreground="{DynamicResource TextPrimary}"
                        HorizontalAlignment="Center"
                        FontSize="26"
                        FontWeight="SemiBold" />
            <TextBlock Text="{Binding Message}"
                        Foreground="{DynamicResource TextSecondary}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14" />
        </StackPanel>
    </Grid>
</UserControl>
